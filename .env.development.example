# ==========================================================
# AnalystGPT Enterprise - LOCAL DEVELOPMENT overrides
#
#   cp .env.development.example .env
#
# Every other setting has a safe default in src/core/config.py; the full
# reference is .env.example (which describes a deployment and will not start
# as-is). Never use this file for anything reachable from a network.
# ==========================================================

# Enables local conveniences: API docs, '*' allowed hosts, and the built-in
# signing key below. The API still refuses that key unless it binds loopback.
APP_ENVIRONMENT=development

# Empty: use the built-in development key. It is published in this
# repository, so tokens can be forged by anyone who can reach the API.
AUTH_SECRET_KEY=

API_HOST=127.0.0.1
DATABASE_ENGINE=sqlite
LOG_LEVEL=INFO
