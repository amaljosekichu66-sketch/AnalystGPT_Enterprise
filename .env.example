# ==========================================================
# AnalystGPT Enterprise — Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# DO NOT commit real secrets or production credentials to source control.
#
# This template describes a DEPLOYMENT: it runs in production mode and ships
# a placeholder signing key that the API refuses, so a copy used unchanged
# cannot start with a forgeable key (P2-18). For local development use
# .env.development.example instead.
# ==========================================================

# ==========================================================
# Application & Logging
# ==========================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable file logging in addition to console output: true/false
LOG_TO_FILE=false

# File path for file logging (default: logs/analystgpt.log)
LOG_FILE_PATH=logs/analystgpt.log

# Maximum file size before rotation in bytes (default: 10485760 = 10MB)
LOG_MAX_BYTES=10485760

# Number of rotated backup files to retain
LOG_BACKUP_COUNT=5

# ==========================================================
# Web API & Frontend Networking
# ==========================================================

# Host and port for FastAPI backend service. Loopback by default; expose the
# API through a TLS-terminating reverse proxy rather than binding 0.0.0.0.
# (The Docker image binds 0.0.0.0 inside the container itself.)
API_HOST=127.0.0.1
API_PORT=8000

# Interactive docs (/docs, /redoc, /openapi.json). Default: on in development,
# off otherwise.
# API_DOCS_ENABLED=false

# Docker Compose publishes the API and frontend on loopback only unless these
# are changed (e.g. 0.0.0.0). Prefer a reverse proxy in front instead.
# API_BIND_ADDRESS=127.0.0.1
# FRONTEND_BIND_ADDRESS=127.0.0.1

# Base URL used by Frontend and external clients to communicate with the REST API
API_BASE_URL=http://localhost:8000

# Port for Streamlit frontend service
FRONTEND_PORT=8501

# Host header allow-list. '*' in development; deployed default is the compose
# topology (api,localhost,127.0.0.1). Add your public hostname behind a proxy.
# API_ALLOWED_HOSTS=api,localhost,127.0.0.1

# Send Strict-Transport-Security. Only when the API is served over HTTPS.
# API_HSTS_ENABLED=false

# Peers (IPs/CIDRs) whose X-Forwarded-For is trusted for rate limiting and
# lockout: the Streamlit frontend and any reverse proxy. Compose sets it to
# the frontend's fixed address (ANALYSTGPT_FRONTEND_IP, default 172.28.0.10,
# on ANALYSTGPT_SUBNET, default 172.28.0.0/24).
# TRUSTED_PROXY_IPS=

# Reverse proxy in production: also cap the request body there (the API caps
# uploads at MAX_FILE_SIZE_MB and other bodies at MAX_REQUEST_BODY_KB) and
# send "Content-Security-Policy: img-src 'self' data:" on the frontend, so a
# model-emitted markdown image cannot beacon out.

# ==========================================================
# Database Configuration
# ==========================================================

# Active database engine: 'sqlite' or 'postgresql'
DATABASE_ENGINE=sqlite

# PostgreSQL Connection Settings (required when DATABASE_ENGINE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=analystgpt
POSTGRES_USER=postgres
# REQUIRED by Docker Compose (no fallback): use a long random value.
POSTGRES_PASSWORD=your_secure_password_here

# Docker Compose: the API connects as this least-privilege role, not the
# superuser above. Created by docker/postgres/init-app-role.sh when the data
# volume is first initialised; for an EXISTING volume run that script once.
APP_DB_USER=analystgpt_app
APP_DB_PASSWORD=another_secure_password_here

# TLS: libpq's default 'prefer' does not verify the server. Use 'verify-full'
# with a CA file when the database is on another host.
# POSTGRES_SSLMODE=prefer
# POSTGRES_SSLROOTCERT=
# POSTGRES_CONNECT_TIMEOUT=10

# ==========================================================
# AI Insight Engine / LLM Configuration
# ==========================================================

# Active LLM provider: 'ollama' (default)
LLM_PROVIDER=ollama

# Local Ollama Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Plain HTTP to a non-local Ollama is refused: use an HTTPS proxy with
# authentication (its token in OLLAMA_API_KEY), or acknowledge the risk.
# OLLAMA_ALLOW_INSECURE=false
# OLLAMA_API_KEY=
# Log raw model responses (DEBUG, newlines escaped). They can repeat data.
# LOG_LLM_RESPONSES=false
OLLAMA_KEEP_ALIVE=30m

# Generation Hyperparameters
AI_TEMPERATURE=0.2
AI_TOP_P=0.90

# Maximum tokens the model may generate. The prompt sizes its per-section word
# limits against this value; the two are asserted consistent by
# tests/ai/test_prompt_output_budget.py.
AI_MAX_TOKENS=1024

# Context window. MUST hold the prompt AND the generated response together.
# Measured on the reference dataset: prompt 4,653 tokens + 1,024 generated
# = 5,677 required. The previous default of 4096 overflowed, and Ollama
# responds by silently discarding the OLDEST tokens - the analytical integrity
# rules at the head of the prompt - which also truncated the final section.
AI_CONTEXT_WINDOW=8192

# Per-request inference timeout, seconds. Sized for CPU-only inference: a full
# report generation was measured at 340s cold on this hardware, and prompt-eval
# throughput varies 15-24 tok/s with machine load. Lower it on GPU hardware.
AI_TIMEOUT=600

AI_MAX_RETRIES=3

# ==========================================================
# Deployment Environment & Security
# ==========================================================

# 'development' enables local conveniences that are unsafe when deployed.
# It must be set EXPLICITLY: if APP_ENVIRONMENT is unset, the application
# treats itself as 'production'. Any value other than 'development' is a
# deployed environment and the guards below become mandatory.
# Docker Compose sets APP_ENVIRONMENT=production for its services. Local
# development overrides live in .env.development.example.
APP_ENVIRONMENT=production

# Signing key for access tokens (HMAC-SHA256 / HS256).
#
# Outside 'development' the API REFUSES TO START if this is missing, empty,
# shorter than 32 bytes (the 256-bit minimum for HS256), or equal to the
# built-in development key - which is published in this repository, so anyone
# could forge a token for any user and role with it. Leaving it empty is only
# acceptable with APP_ENVIRONMENT=development, where the built-in key is used.
# Docker Compose requires it and has no fallback.
#
# The value below is a placeholder that the API REFUSES in every environment.
# Replace it. Never commit a real value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=CHANGE_ME-replace-with-output-of-secrets-token-urlsafe-48

# Accept unauthenticated X-User-Id / X-User-Name / X-User-Role headers as
# proof of identity. This is a COMPLETE authentication bypass - a caller can
# assert ADMIN with no token - and exists only for local development and the
# API test-suite. Defaults to false, and cannot be enabled unless
# APP_ENVIRONMENT=development.
AUTH_ALLOW_HEADER_IDENTITY=false

# Public sign-up at POST /api/auth/register. New accounts are read-only
# VIEWERs; an administrator grants ANALYST with PATCH /api/admin/users/{id}.
# Set to false to accept only accounts created by an administrator.
AUTH_SELF_REGISTRATION_ENABLED=true

# Upper bound on any access token's lifetime, minutes.
# AUTH_TOKEN_MAX_LIFETIME_MINUTES=720

# Lockout: AUTH_LOGIN_MAX_FAILURES per account from one address locks that
# address out (doubling up to AUTH_LOGIN_LOCKOUT_MAX_SECONDS). Across all
# addresses an account only gets a short back-off; one address failing
# against many accounts is locked for all of them (password spraying).
# Lockout state is stored in the database.
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_ACCOUNT_MAX_FAILURES=20
# AUTH_LOGIN_ACCOUNT_LOCKOUT_SECONDS=30
# AUTH_LOGIN_SOURCE_MAX_FAILURES=30

# Quotas and per-client limits ("<requests>/<seconds>"). The rate limiter is
# in-process: run ONE API worker, or each worker keeps its own counters.
# MAX_ACTIVE_AI_JOBS_PER_USER=2
# AI_MAX_QUEUED_JOBS=32
# PIPELINE_RATE_LIMIT=10/60
# AI_RETRY_RATE_LIMIT=10/60
# GOVERNANCE_PREVIEW_RATE_LIMIT=30/60

# Upload and request limits.
# MAX_FILE_SIZE_MB=100
# MAX_JSON_FILE_SIZE_MB=50
# MAX_REQUEST_BODY_KB=1024
# Delete uploads older than this many days at startup (0 = keep).
# DATASET_RETENTION_DAYS=0

# Comma-separated CORS allow-list. Do NOT use '*': combined with credentials,
# Starlette reflects the caller's Origin instead, which trusts every site.
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://127.0.0.1:8000

# ==========================================================
# Persistence Paths (override for isolated runs)
# ==========================================================

# Defaults point at the working tree. The test-suite redirects all three to a
# temporary directory (see tests/conftest.py) so a pytest run cannot write to
# the development database, reports or artifact store.
# SQLITE_DATABASE_PATH=
# REPORT_OUTPUT_DIRECTORY=
# ARTIFACT_STORE_DIRECTORY=
