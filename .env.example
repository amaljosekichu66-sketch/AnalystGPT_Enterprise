# ==========================================================
# AnalystGPT Enterprise — Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ==========================================================

# ==========================================================
# Application & Logging
# ==========================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable file logging in addition to console output: true/false
LOG_TO_FILE=false

# File path for file logging (default: logs/analystgpt.log)
LOG_FILE_PATH=logs/analystgpt.log

# Maximum file size before rotation in bytes (default: 10485760 = 10MB)
LOG_MAX_BYTES=10485760

# Number of rotated backup files to retain
LOG_BACKUP_COUNT=5

# ==========================================================
# Web API & Frontend Networking
# ==========================================================

# Host and port for FastAPI backend service
API_HOST=0.0.0.0
API_PORT=8000

# Base URL used by Frontend and external clients to communicate with the REST API
API_BASE_URL=http://localhost:8000

# Port for Streamlit frontend service
FRONTEND_PORT=8501

# ==========================================================
# Database Configuration
# ==========================================================

# Active database engine: 'sqlite' or 'postgresql'
DATABASE_ENGINE=sqlite

# PostgreSQL Connection Settings (required when DATABASE_ENGINE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=analystgpt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ==========================================================
# AI Insight Engine / LLM Configuration
# ==========================================================

# Active LLM provider: 'ollama' (default)
LLM_PROVIDER=ollama

# Local Ollama Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=30m

# Generation Hyperparameters
AI_TEMPERATURE=0.2
AI_TOP_P=0.90
AI_MAX_TOKENS=1024
AI_CONTEXT_WINDOW=4096
AI_TIMEOUT=120
AI_MAX_RETRIES=3

# ==========================================================
# Optional Cloud LLM Providers (Sprint 12+)
# ==========================================================

OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
