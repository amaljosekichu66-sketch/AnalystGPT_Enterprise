# ==========================================================
# AnalystGPT Enterprise — Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ==========================================================

# ==========================================================
# Application & Logging
# ==========================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable file logging in addition to console output: true/false
LOG_TO_FILE=false

# File path for file logging (default: logs/analystgpt.log)
LOG_FILE_PATH=logs/analystgpt.log

# Maximum file size before rotation in bytes (default: 10485760 = 10MB)
LOG_MAX_BYTES=10485760

# Number of rotated backup files to retain
LOG_BACKUP_COUNT=5

# ==========================================================
# Web API & Frontend Networking
# ==========================================================

# Host and port for FastAPI backend service
API_HOST=0.0.0.0
API_PORT=8000

# Base URL used by Frontend and external clients to communicate with the REST API
API_BASE_URL=http://localhost:8000

# Port for Streamlit frontend service
FRONTEND_PORT=8501

# ==========================================================
# Database Configuration
# ==========================================================

# Active database engine: 'sqlite' or 'postgresql'
DATABASE_ENGINE=sqlite

# PostgreSQL Connection Settings (required when DATABASE_ENGINE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=analystgpt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ==========================================================
# AI Insight Engine / LLM Configuration
# ==========================================================

# Active LLM provider: 'ollama' (default)
LLM_PROVIDER=ollama

# Local Ollama Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=30m

# Generation Hyperparameters
AI_TEMPERATURE=0.2
AI_TOP_P=0.90

# Maximum tokens the model may generate. The prompt sizes its per-section word
# limits against this value; the two are asserted consistent by
# tests/ai/test_prompt_output_budget.py.
AI_MAX_TOKENS=1024

# Context window. MUST hold the prompt AND the generated response together.
# Measured on the reference dataset: prompt 4,653 tokens + 1,024 generated
# = 5,677 required. The previous default of 4096 overflowed, and Ollama
# responds by silently discarding the OLDEST tokens - the analytical integrity
# rules at the head of the prompt - which also truncated the final section.
AI_CONTEXT_WINDOW=8192

# Per-request inference timeout, seconds. Sized for CPU-only inference: a full
# report generation was measured at 340s cold on this hardware, and prompt-eval
# throughput varies 15-24 tok/s with machine load. Lower it on GPU hardware.
AI_TIMEOUT=600

AI_MAX_RETRIES=3

# ==========================================================
# Optional Cloud LLM Providers (Sprint 12+)
# ==========================================================

OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# ==========================================================
# Deployment Environment & Security
# ==========================================================

# 'development' enables local conveniences that are unsafe when deployed.
# Any other value is treated as a deployed environment and the guards below
# become mandatory.
APP_ENVIRONMENT=development

# Signing key for access tokens. The built-in default is published in this
# repository, so anyone can forge a token for any user and role with it.
# Startup FAILS if this is left unset while APP_ENVIRONMENT is not
# 'development'. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# Accept unauthenticated X-User-Id / X-User-Name / X-User-Role headers as
# proof of identity. This is a COMPLETE authentication bypass - a caller can
# assert ADMIN with no token - and exists only for local development and the
# API test-suite. Defaults to false, and cannot be enabled unless
# APP_ENVIRONMENT=development.
AUTH_ALLOW_HEADER_IDENTITY=false

# Comma-separated CORS allow-list. Do NOT use '*': combined with credentials,
# Starlette reflects the caller's Origin instead, which trusts every site.
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://127.0.0.1:8000

# ==========================================================
# Persistence Paths (override for isolated runs)
# ==========================================================

# Defaults point at the working tree. The test-suite redirects all three to a
# temporary directory (see tests/conftest.py) so a pytest run cannot write to
# the development database, reports or artifact store.
# SQLITE_DATABASE_PATH=
# REPORT_OUTPUT_DIRECTORY=
# ARTIFACT_STORE_DIRECTORY=
